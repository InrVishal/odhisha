# Copy to .env.local for local dev. Never commit real values.
# In Vercel, set these per environment (Development / Preview / Production).

# Postgres. Local dev can use an in-process database: pglite:./.pglite
# Preview/Production: the Neon connection string (pooled).
DATABASE_URL=pglite:./.pglite
# Neon direct (unpooled) URL, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# Auth.js. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Optional Google login. On Vercel, set these in Development and Production
# only: Google has no wildcard redirect URIs, so it can't work on preview URLs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Origins whose <origin>/api/auth/callback/google is registered in Google Cloud Console.
AUTH_GOOGLE_REDIRECT_ORIGINS=http://localhost:3000

# Magic-link email: "console" prints the link to the server log (dev only).
# Preview/Production default to "resend". Resend needs a verified domain to
# deliver to anyone except the account owner.
EMAIL_TRANSPORT=console
AUTH_RESEND_KEY=
EMAIL_FROM="NightShift <login@example.com>"

# Rate limiting: "memory" is dev only. Preview/Production default to Upstash.
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN, which are accepted in place of the two below.
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET. 32+ chars.
CRON_SECRET=

# Phase 3+: Ed25519 PKCS#8 private key (base64) and 32-byte data key (base64).
COORDINATOR_SIGNING_KEY=
DATA_ENCRYPTION_KEY=

SENTRY_DSN=
DEMO_MODE=true
